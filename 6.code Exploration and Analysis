run_model <- function(i,exposure,model_name,covariates){
  
  dat <- MI_list[[i]]
  design <- design_list[[i]]
  
  available <- !is.na(dat[[exposure]]) &
    !is.na(dat[[outcome]])
  
  n_available <- sum(available)
  n_events <- sum(dat[[outcome]][available]==1,na.rm=TRUE)
  
  if(n_available==0){
    return(tibble(
      Exposure=exposure,Model=model_name,MI=i,
      N=0,Events=0,beta=NA_real_,SE=NA_real_,
      Status="No available observations"
    ))
  }
  
  # Survey subpopulation rather than rebuilding design after filtering
  dsub <- subset(design,available)
  
  formula_model <- as.formula(
    paste(
      outcome,
      "~",
      paste(c(exposure,covariates),collapse="+")
    )
  )
  
  fit <- tryCatch(
    svyglm(
      formula_model,
      design=dsub,
      family=quasibinomial()
    ),
    error=function(e) NULL
  )
  
  if(is.null(fit)){
    return(tibble(
      Exposure=exposure,Model=model_name,MI=i,
      N=n_available,Events=n_events,beta=NA_real_,SE=NA_real_,
      Status="Model failed"
    ))
  }
  
  b <- coef(fit)
  V <- vcov(fit)
  
  if(!exposure %in% names(b)){
    return(tibble(
      Exposure=exposure,Model=model_name,MI=i,
      N=n_available,Events=n_events,beta=NA_real_,SE=NA_real_,
      Status="Exposure coefficient missing"
    ))
  }
  
  tibble(
    Exposure=exposure,
    Model=model_name,
    MI=i,
    N=n_available,
    Events=n_events,
    beta=unname(b[exposure]),
    SE=sqrt(V[exposure,exposure]),
    Status="Success"
  )
}

