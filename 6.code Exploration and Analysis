clean_deq <- function(x,valid){
  
  x <- suppressWarnings(as.numeric(x))
  
  ifelse(
    x %in% valid,
    x,
    NA_real_
  )
  
}



################################################################################
# Processing function
################################################################################


process_DEQ <- function(table_name,cycle_label){
  
  cat(
    "Processing:",
    cycle_label,
    "\n"
  )
  
  
  raw <- nhanes(table_name)
  
  
  vars <- c(
    "SEQN",
    "DEQ034A",
    "DEQ034C",
    "DEQ034D"
  )
  
  
  missing_vars <- setdiff(
    vars,
    names(raw)
  )
  
  
  if(length(missing_vars)>0)
    stop(
      "Missing variables:",
      paste(missing_vars,collapse=", ")
    )
  
  
  
  raw %>%
    select(all_of(vars)) %>%
    mutate(
      
      SEQN=as.numeric(SEQN),
      
      DEQ034A_raw=DEQ034A,
      DEQ034C_raw=DEQ034C,
      DEQ034D_raw=DEQ034D,
      
      
      DEQ034A=
        clean_deq(
          DEQ034A,
          c(1,2,3,4,5,6)
        ),
      
      
      DEQ034C=
        clean_deq(
          DEQ034C,
          c(1,2,3,4,5)
        ),
      
      
      DEQ034D=
        clean_deq(
          DEQ034D,
          c(1,2,3,4,5)
        ),
      
      
      
      ############################################################
      # Primary definition
      #
      # 1/2 = active shade avoidance
      # 3/4/5 = no active avoidance
      # 6 = Don't go out in sun -> missing
      ############################################################
      
      shade_avoidance =
        case_when(
          
          DEQ034A %in% c(1,2) ~ 1,
          
          DEQ034A %in% c(3,4,5) ~ 0,
          
          TRUE ~ NA_real_
          
        ),
      
      
      
      ############################################################
      # Sensitivity definition
      #
      # Assume DEQ034A=6 represents extreme sun avoidance
      ############################################################
      
      
      shade_avoidance_sensitivity =
        case_when(
          
          DEQ034A %in% c(1,2,6) ~ 1,
          
          DEQ034A %in% c(3,4,5) ~ 0,
          
          TRUE ~ NA_real_
          
        ),
      
      
      
      ############################################################
      
      long_sleeve_behavior =
        case_when(
          
          DEQ034C %in% c(1,2) ~ 1,
          
          DEQ034C %in% c(3,4,5) ~ 0,
          
          TRUE ~ NA_real_
          
        ),
      
      
      
      sunscreen_behavior =
        case_when(
          
          DEQ034D %in% c(1,2) ~ 1,
          
          DEQ034D %in% c(3,4,5) ~ 0,
          
          TRUE ~ NA_real_
          
        ),
      
      
      
      CYCLE=cycle_label
      
    )
  
}



