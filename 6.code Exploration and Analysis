run_model <- function(i,exposure,model_name,covariates){
  
  dat <- MI_list[[i]]
  design <- design_list[[i]]
  
  available <- !is.na(dat[[exposure]]) &
    !is.na(dat[[outcome]])
  
  n_available <- sum(available)
  
  if(n_available==0){
    return(tibble(
      Exposure=exposure,
      Model=model_name,
      MI=i,
      N=0,
      beta=NA_real_,
      SE=NA_real_,
      Status="No available observations"
    ))
  }
  
  dsub <- subset(design,available)
  
  formula_model <- as.formula(
    paste(
      outcome,
      "~",
      paste(c(exposure,covariates),collapse="+")
    )
  )
  
  fit <- tryCatch(
    svyglm(
      formula_model,
      design=dsub,
      family=gaussian()
    ),
    error=function(e) NULL
  )
  
  if(is.null(fit)){
    return(tibble(
      Exposure=exposure,
      Model=model_name,
      MI=i,
      N=n_available,
      beta=NA_real_,
      SE=NA_real_,
      Status="Model failed"
    ))
  }
  
  b <- coef(fit)
  V <- vcov(fit)
  
  if(!exposure %in% names(b)){
    return(tibble(
      Exposure=exposure,
      Model=model_name,
      MI=i,
      N=n_available,
      beta=NA_real_,
      SE=NA_real_,
      Status="Exposure coefficient missing"
    ))
  }
  
  tibble(
    Exposure=exposure,
    Model=model_name,
    MI=i,
    N=n_available,
    beta=unname(b[exposure]),
    SE=sqrt(V[exposure,exposure]),
    Status="Success"
  )
}

