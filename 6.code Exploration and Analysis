# ==============================================================================
# 14. RUBIN POOLING — FINITE-DF t INFERENCE
# ==============================================================================

pool_scalar <- function(df){
  
  ok <- is.finite(df$Beta) & is.finite(df$SE)
  
  beta <- df$Beta[ok]
  se <- df$SE[ok]
  
  m <- length(beta)
  
  if(m<2){
    return(
      tibble(
        M=m,
        Beta=NA_real_,
        SE=NA_real_,
        df=NA_real_,
        Lower_beta=NA_real_,
        Upper_beta=NA_real_,
        OR=NA_real_,
        Lower95=NA_real_,
        Upper95=NA_real_,
        P=NA_real_
      )
    )
  }
  
  qbar <- mean(beta)
  W <- mean(se^2)
  B <- var(beta)
  
  T <- W+(1+1/m)*B
  SE_pool <- sqrt(T)
  
  if(is.finite(B) && B>0 && is.finite(W) && W>0){
    
    r <- ((1+1/m)*B)/W
    df <- (m-1)*(1+1/r)^2
    
  }else{
    
    df <- Inf
  }
  
  crit <- if(is.finite(df))
    qt(0.975,df=df) else qnorm(0.975)
  
  stat <- qbar/SE_pool
  
  p <- if(is.finite(df))
    2*pt(abs(stat),df=df,lower.tail=FALSE)
  else
    2*pnorm(abs(stat),lower.tail=FALSE)
  
  lower_beta <- qbar-crit*SE_pool
  upper_beta <- qbar+crit*SE_pool
  
  tibble(
    M=m,
    Beta=qbar,
    SE=SE_pool,
    df=df,
    Lower_beta=lower_beta,
    Upper_beta=upper_beta,
    OR=exp(qbar),
    Lower95=exp(lower_beta),
    Upper95=exp(upper_beta),
    P=p
  )
}

