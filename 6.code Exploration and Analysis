  mutate(
    Exposure_label=recode(
      Exposure,
      !!!exposure_labels
    ),
    
    Model_label=recode(
      Model,
      !!!model_labels
    ),
    
    Exposure_label=factor(
      Exposure_label,
      levels=exposure_order
    ),
    
    Model_label=factor(
      Model_label,
      levels=c("Model 1","Model 2","Model 3")
    ),
    
    OR_95CI=sprintf(
      "%.3f (%.3f to %.3f)",
      OR,
      Lower95,
      Upper95
    ),
    
    P_fmt=case_when(
      is.na(P) ~ "—",
      P<0.001 ~ "<0.001",
      TRUE ~ sprintf("%.3f",P)
    ),
    
    FDR_fmt=case_when(
      is.na(P_FDR) ~ "—",
      P_FDR<0.001 ~ "<0.001",
      TRUE ~ sprintf("%.3f",P_FDR)
    )
  ) %>%
  
  arrange(
    Exposure_label,
    Model_label
  ) %>%
  
  select(
    Exposure=Exposure_label,
    Model=Model_label,
    M,
    OR,
    Lower_95CI=Lower95,
    Upper_95CI=Upper95,
    `OR (95% CI)`=OR_95CI,
    `P value`=P_fmt,
    P_FDR_numeric=P_FDR,
    `FDR-adjusted P`=FDR_fmt
  ) %>%
  
  mutate(
    Exposure=as.character(Exposure),
    Model=as.character(Model)
  )

write_csv(
  publication_table,
  file.path(
    out_dir,
    "Step28_publication_results_FINAL.csv"
  )
)

