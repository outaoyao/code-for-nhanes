run_model <- function(i,exposure,model_name,covariates){
  
  dat <- MI_1720[[i]]
  design <- design_list[[i]]
  
  available <-
    !is.na(dat[[exposure]]) &
    !is.na(dat[[outcome]])
  
  N_analysis <- sum(available)
  
  if(N_analysis==0){
    
    return(
      tibble(
        MI=i,Exposure=exposure,Model=model_name,N=0,
        Beta=NA_real_,SE=NA_real_,Status="No observations"
      )
    )
  }
  
  dsub <- subset(
    design,
    available
  )
  
  f <- as.formula(
    paste(
      outcome,
      "~",
      paste(
        c(exposure,covariates),
        collapse="+"
      )
    )
  )
  
  fit <- tryCatch(
    svyglm(
      f,
      design=dsub,
      family=gaussian()
    ),
    error=function(e) NULL
  )
  
  if(is.null(fit)){
    
    return(
      tibble(
        MI=i,Exposure=exposure,Model=model_name,N=N_analysis,
        Beta=NA_real_,SE=NA_real_,Status="Model failed"
      )
    )
  }
  
  b <- coef(fit)
  V <- vcov(fit)
  
  if(!exposure %in% names(b)){
    
    return(
      tibble(
        MI=i,Exposure=exposure,Model=model_name,N=N_analysis,
        Beta=NA_real_,SE=NA_real_,
        Status="Exposure coefficient missing"
      )
    )
  }
  
  tibble(
    MI=i,
    Exposure=exposure,
    Model=model_name,
    N=N_analysis,
    Beta=unname(b[exposure]),
    SE=sqrt(V[exposure,exposure]),
    Status="Success"
  )
}

