prepare_MI <- function(dat){
  
  if(!"SEQN" %in% names(dat))
    stop("SEQN missing from MI dataset.")
  
  dat$SEQN <- as.numeric(dat$SEQN)
  
  n_full <- nrow(dat)
  
  dat <- dat %>%
    left_join(
      demo_1720,
      by="SEQN"
    )
  
  if(nrow(dat)!=n_full)
    stop("Demographic merge changed MI sample size.")
  
  dat <- dat %>%
    filter(!is.na(cycle_1720))
  
  if(nrow(dat)==0)
    stop("No 2017-2020 participants remained after demographic merge.")
  
  bad_weight <- is.na(dat$WTMECPRP_original) |
    dat$WTMECPRP_original<=0
  
  if(any(bad_weight)){
    stop(
      "Missing/non-positive WTMECPRP detected in STEP28 analytic-cycle cohort: ",
      sum(bad_weight)
    )
  }
  
  bad_design <- is.na(dat$PSU_1720) |
    is.na(dat$STRATA_1720)
  
  if(any(bad_design)){
    stop(
      "Missing PSU/strata detected in STEP28 analytic-cycle cohort: ",
      sum(bad_design)
    )
  }
  
  n_before <- nrow(dat)
  
  dat <- dat %>%
    left_join(
      Outdoor,
      by="SEQN"
    )
  
  if(nrow(dat)!=n_before)
    stop("Outdoor merge changed sample size.")
  
  required <- unique(c(
    "SEQN",
    outcome,
    cov_model3,
    "WTMECPRP_original",
    "PSU_1720",
    "STRATA_1720"
  ))
  
  miss <- setdiff(required,names(dat))
  
  if(length(miss)>0)
    stop(
      "Missing analytic variables: ",
      paste(miss,collapse=", ")
    )
  
  for(v in factor_vars){
    if(!is.factor(dat[[v]]))
      dat[[v]] <- factor(dat[[v]])
  }
  
  dat[[outcome]] <- case_when(
    dat[[outcome]] %in% c(1,"1","Yes") ~ 1,
    dat[[outcome]] %in% c(0,"0","No") ~ 0,
    TRUE ~ NA_real_
  )
  
  dat
}

