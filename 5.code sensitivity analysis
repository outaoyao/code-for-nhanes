      "MI dataset:",
      
      m,
      
      "\n"
      
    )
    
    
    
    tmp <-
      
      run_MI_model(
        
        analysis_list[[m]],
        
        outcome_name
        
      )
    
    
    
    tmp$MI <- m
    
    tmp$Outcome <- outcome_label
    
    
    
    all_results[[counter]] <- tmp
    
    
    counter <- counter+1
    
    
  }
  
  
  
  bind_rows(all_results)
  
  
}



