compare_knots <- function(exposure, covars = model4_covars) {
  
  out <- data.frame(
    exposure = exposure,
    knots = 3:5,
    AIC = NA_real_,
    p_compare_linear = NA_real_
  )
  
  lin_formula <- as.formula(
    paste(
      outcome_var,
      "~",
      paste(c(exposure, covars), collapse = " + ")
    )
  )
  
  lin_fit <- svyglm(
    lin_formula,
    design = design,
    family = quasibinomial()
  )
  
  for (k in 3:5) {
    
    spline_fit <- fit_svy_rcs(exposure, covars, k)
    
    out$AIC[out$knots == k] <- AIC(spline_fit)[1]
    
    out$p_compare_linear[out$knots == k] <- tryCatch(
      anova(lin_fit, spline_fit)$p[2],
      error = function(e) NA_real_
    )
  }
  
  out
}

