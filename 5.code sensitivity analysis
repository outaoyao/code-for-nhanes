# ==============================================================================


run_MI_model <- function(
    
  dat,
  
  outcome_name
  
){
  
  
  design <- svydesign(
    
    id=~SDMVPSU,
    
    strata=~SDMVSTRA,
    
    weights=~mec_adj,
    
    nest=TRUE,
    
    data=dat
    
  )
  
  
  
  formula <- as.formula(
    
    paste(
      
      outcome_name,
      
      "~",
      
      paste(
        
        c(
          
          "sleep_rhythm_index_z",
          
          cov_model4
          
        ),
        
        collapse="+"
        
      )
      
    )
    
  )
  
  
  
  fit <- svyglm(
    
    formula,
    
    design=design,
    
    family=quasibinomial()
    
  )
  
  
  
  est <- summary(fit)$coef
  
  
  
  result <- tibble(
    
    term=
      rownames(est),
    
    beta=
      est[,1],
    
    SE=
      est[,2],
    
    p_value=
      est[,4]
    
  )%>%
    
    mutate(
      
      OR=
        exp(beta),
      
      CI_lower=
        exp(beta-1.96*SE),
      
      CI_upper=
        exp(beta+1.96*SE)
      
    )
  
  
  result
  
  
}



