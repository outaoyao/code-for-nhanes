  )
  
  bind_cols(
    dat,
    R
  )
}

# ==============================================================================
# 8. FIT + POOL FUNCTION
# ==============================================================================

run_rcs_outcome <- function(
    outcome_name,
    outcome_label
){
  
  cat(
    "\n============================================================\n",
    "Running outcome: ",outcome_label,"\n",
    "============================================================\n",
    sep=""
  )
  
  model_list <- vector("list",M)
  beta_list <- vector("list",M)
  vcov_list <- vector("list",M)
  
  for(i in seq_len(M)){
    
    cat("MI:",i,"\n")
    
    dat <- make_rcs(
      MI_list[[i]]
    )
    
    rcs_vars <- grep(
      "^RCS",
      names(dat),
      value=TRUE
    )
    
    design <- svydesign(
      id=~SDMVPSU,
      strata=~SDMVSTRA,
      weights=~mec_adj,
      nest=TRUE,
      data=dat
    )
    
    formula_rcs <- as.formula(
      paste(
        outcome_name,
        "~",
        paste(
          c(
            rcs_vars,
            covariates
          ),
          collapse="+"
        )
      )
    )
    
    fit <- svyglm(
      formula_rcs,
      design=design,
      family=quasibinomial()
    )
    
    model_list[[i]] <- fit
    beta_list[[i]] <- coef(fit)
    vcov_list[[i]] <- vcov(fit)
  }
  
  # --------------------------------------------------------------------------
  # Coefficient compatibility QC
  # --------------------------------------------------------------------------
  
  term_list <- lapply(
    beta_list,
    names
  )
  
  same_terms <- all(
    vapply(
      term_list,
      identical,
      logical(1),
      term_list[[1]]
    )
  )
  
  if(!same_terms){
    stop(
      paste0(
        "Coefficient structure differs across MI datasets: ",
        outcome_label
      )
    )
  }
  
  # --------------------------------------------------------------------------
  # Rubin pooling
  # --------------------------------------------------------------------------
  
  terms <- names(
    beta_list[[1]]
  )
  
  beta_matrix <- do.call(
    cbind,
    beta_list
  )
  
  beta_mean <- rowMeans(
    beta_matrix
  )
  
  names(beta_mean) <- terms
  
  W <- Reduce(
    "+",
    vcov_list
  )/M
  
  B <- matrix(
    0,
    nrow=length(terms),
    ncol=length(terms),
    dimnames=list(
      terms,
      terms
    )
  )
  
  for(i in seq_len(M)){
    
    d <- beta_list[[i]]-
      beta_mean
    
    B <- B+
      d%*%t(d)
  }
  
  B <- B/(M-1)
  
  Tmat <- W+
    (1+1/M)*B
  
  rownames(Tmat) <- terms
  colnames(Tmat) <- terms
  
  # --------------------------------------------------------------------------
  # RCS terms
  # --------------------------------------------------------------------------
  
  rcs_terms <- grep(
    "^RCS",
    terms,
    value=TRUE
  )
  
  if(length(rcs_terms)<2){
    stop(
      paste0(
        "Insufficient RCS terms: ",
        outcome_label
      )
    )
  }
  
  beta_rcs <- beta_mean[
    rcs_terms
  ]
  
  V_rcs <- Tmat[
    rcs_terms,
    rcs_terms,
    drop=FALSE
  ]
  
  # --------------------------------------------------------------------------
  # Overall association
  # --------------------------------------------------------------------------
  
  Wald_overall <- as.numeric(
    t(beta_rcs)%*%
      solve(V_rcs)%*%
      beta_rcs
  )
  
  df_overall <- length(
    beta_rcs
  )
  
  p_overall <- pchisq(
    Wald_overall,
    df=df_overall,
    lower.tail=FALSE
  )
  
  # --------------------------------------------------------------------------
  # Nonlinear association
  # --------------------------------------------------------------------------
  
  beta_nonlin <- beta_rcs[-1]
  
  V_nonlin <- V_rcs[
    -1,
    -1,
    drop=FALSE
  ]
  
  Wald_nonlin <- as.numeric(
    t(beta_nonlin)%*%
      solve(V_nonlin)%*%
      beta_nonlin
  )
  
  df_nonlin <- length(
    beta_nonlin
  )
  
  p_nonlin <- pchisq(
    Wald_nonlin,
    df=df_nonlin,
    lower.tail=FALSE
  )
  
  # --------------------------------------------------------------------------
  # Prediction grid
  # --------------------------------------------------------------------------
  
  x_seq <- seq(
    plot_limits[1],
    plot_limits[2],
    length.out=300
  )
  
  Xnew <- Hmisc::rcspline.eval(
    x_seq,
    knots=knots,
    inclx=TRUE
  )
  
  Xnew <- as.matrix(
    Xnew
  )
  
  Xnew <- Xnew[
    ,
    seq_along(rcs_terms),
    drop=FALSE
  ]
  
  Xref <- Hmisc::rcspline.eval(
    reference_value,
    knots=knots,
    inclx=TRUE
  )
  
  Xref <- as.numeric(
    Xref
  )
  
  Xref <- Xref[
    seq_along(rcs_terms)
  ]
  
  # --------------------------------------------------------------------------
  # Contrast-based prediction
  # --------------------------------------------------------------------------
  
  Xdiff <- sweep(
    Xnew,
    MARGIN=2,
    STATS=Xref,
    FUN="-"
  )
  
  log_OR <- as.vector(
    Xdiff%*%
      beta_rcs
  )
  
  contrast_var <- rowSums(
    (
      Xdiff%*%
        V_rcs
    )*
      Xdiff
  )
  
  contrast_var <- pmax(
    contrast_var,
    0
  )
  
  contrast_SE <- sqrt(
    contrast_var
  )
  
  curve <- data.frame(
    exposure=x_seq,
    log_OR=log_OR,
    SE=contrast_SE,
    OR=exp(log_OR),
    lower95=
      exp(
        log_OR-
          1.96*contrast_SE
      ),
    upper95=
      exp(
        log_OR+
          1.96*contrast_SE
      )
  )
  
  reference_row <- data.frame(
    exposure=reference_value,
    log_OR=0,
    SE=0,
    OR=1,
    lower95=1,
    upper95=1
  )
  
  curve <- bind_rows(
    curve,
    reference_row
  ) %>%
    arrange(
      exposure
    )
  
  # --------------------------------------------------------------------------
  # Output paths
  # --------------------------------------------------------------------------
  
  safe_name <- gsub(
    "[^A-Za-z0-9]+",
    "_",
    outcome_label
  )
  
  outcome_dir <- file.path(
    out_dir,
    safe_name
  )
  
  dir.create(
    outcome_dir,
    recursive=TRUE,
    showWarnings=FALSE
  )
  
  # --------------------------------------------------------------------------
  # Save curve
  # --------------------------------------------------------------------------
  
  write.csv(
    curve,
    file.path(
      outcome_dir,
      "RCS_curve_data.csv"
    ),
    row.names=FALSE
  )
  
  # --------------------------------------------------------------------------
  # Save P values
  # --------------------------------------------------------------------------
  
  p_table <- data.frame(
    Outcome=outcome_label,
    Test=c(
      "Overall association",
      "Nonlinear association"
    ),
    Wald=c(
      Wald_overall,
      Wald_nonlin
    ),
    df=c(
      df_overall,
      df_nonlin
    ),
    P_value=c(
      p_overall,
      p_nonlin
    ),
    P_formatted=c(
      ifelse(
        p_overall<0.001,
        "<0.001",
        sprintf("%.3f",p_overall)
      ),
      ifelse(
        p_nonlin<0.001,
        "<0.001",
        sprintf("%.3f",p_nonlin)
      )
    )
  )
  
  write.csv(
    p_table,
    file.path(
      outcome_dir,
      "RCS_P_values.csv"
    ),
    row.names=FALSE
  )
  
  # --------------------------------------------------------------------------
  # Reference QC
  # --------------------------------------------------------------------------
  
  ref_check <- curve[
    which.min(
      abs(
        curve$exposure-
          reference_value
      )
    ),
  ]
  
  write.csv(
    ref_check,
    file.path(
      outcome_dir,
      "RCS_reference_QC.csv"
    ),
    row.names=FALSE
  )
  
  # --------------------------------------------------------------------------
  # Figure
  # --------------------------------------------------------------------------
  
  p <- ggplot(
    curve,
    aes(
      x=exposure,
      y=OR
    )
  )+
    
    geom_ribbon(
      aes(
        ymin=lower95,
        ymax=upper95
      ),
      fill="#0072B2",
      alpha=0.18
    )+
    
    geom_line(
      colour="#0072B2",
      linewidth=1.05
    )+
    
    geom_hline(
      yintercept=1,
      linetype="dashed",
      colour="grey45",
      linewidth=0.5
    )+
    
    geom_vline(
      xintercept=reference_value,
      linetype="dotted",
      colour="#D55E00",
      linewidth=0.55
    )+
    
    scale_y_log10()+
    
    labs(
      x="Sleep rhythm disruption index (SD units)",
      y="Odds ratio (95% CI)"
    )+
    
    theme_classic(
      base_size=11
    )+
    
    theme(
      axis.text=
        element_text(
          colour="black"
        ),
      axis.title=
        element_text(
          colour="black"
        ),
      plot.margin=
        margin(
          8,
          10,
          8,
          8
        )
    )
  
  print(p)
  
  ggsave(
    file.path(
      outcome_dir,
      "RCS_curve.tiff"
    ),
    p,
    width=6.5,
    height=4.8,
    units="in",
    dpi=600,
    compression="lzw",
    bg="white"
  )
  
  ggsave(
    file.path(
      outcome_dir,
      "RCS_curve.pdf"
    ),
    p,
    width=6.5,
    height=4.8,
    units="in",
    device=grDevices::cairo_pdf,
    bg="white"
  )
  
  # --------------------------------------------------------------------------
  # Return summary
  # --------------------------------------------------------------------------
  
  tibble(
    Outcome=outcome_label,
    Outcome_variable=outcome_name,
    Overall_P=p_overall,
    Nonlinear_P=p_nonlin,
    Overall_P_fmt=
      ifelse(
        p_overall<0.001,
        "<0.001",
        sprintf("%.3f",p_overall)
      ),
    Nonlinear_P_fmt=
      ifelse(
        p_nonlin<0.001,
        "<0.001",
        sprintf("%.3f",p_nonlin)
      ),
    Reference=reference_value,
    Plot_lower=plot_limits[1],
    Plot_upper=plot_limits[2]
  )
}

