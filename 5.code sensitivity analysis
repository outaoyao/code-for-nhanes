get_mode_value <- function(x) {
  x <- x[!is.na(x)]
  names(sort(table(x), decreasing = TRUE))[1]
}

make_reference_newdata <- function(data, exposure, n_grid = 200,
                                   force_range = c(0, 24)) {
  
  grid <- seq(
    force_range[1],
    force_range[2],
    length.out = n_grid
  )
  
  newdat <- data.frame(tmp_exposure = grid)
  names(newdat)[1] <- exposure
  
  for (v in model4_covars) {
    
    if (v == exposure) next
    
    if (is.factor(data[[v]])) {
      
      ref <- get_mode_value(data[[v]])
      
      newdat[[v]] <- factor(
        ref,
        levels = levels(data[[v]])
      )
      
    } else {
      
      newdat[[v]] <- median(data[[v]], na.rm = TRUE)
    }
  }
  
  newdat
}

# ==============================================================================
# 11. Manual RCS prediction using model matrix
# ==============================================================================

extract_rcs_data_manual <- function(model, exposure, time_type, model_name) {
  
  newdat <- make_reference_newdata(
    data = nhanes_rcs,
    exposure = exposure,
    n_grid = 200,
    force_range = c(0, 24)
  )
  
  model_terms <- delete.response(terms(model))
  
  X <- model.matrix(
    model_terms,
    data = newdat
  )
  
  coefs <- coef(model)
  V <- vcov(model)
  
  common <- intersect(colnames(X), names(coefs))
  
  X <- X[, common, drop = FALSE]
  coefs <- coefs[common]
  V <- V[common, common, drop = FALSE]
  
  fit <- as.numeric(X %*% coefs)
  se <- sqrt(pmax(0, rowSums((X %*% V) * X)))
  
  ref_fit <- min(fit, na.rm = TRUE)
  
  dat <- data.frame(
    hours = newdat[[exposure]],
    yhat = exp(fit - ref_fit),
    lower = exp((fit - 1.96 * se) - ref_fit),
    upper = exp((fit + 1.96 * se) - ref_fit),
    time_type = time_type,
    model = model_name
  )
  
  dat <- dat[complete.cases(dat), ]
  
  dat
}

