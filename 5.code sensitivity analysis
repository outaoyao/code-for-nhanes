# ==============================================================================
# 18. Formal weighted RCS P values for all models
#     Overall P   = Wald test for all RCS coefficients
#     Nonlinear P = Wald test for nonlinear RCS coefficients only
# ==============================================================================

wald_test_terms <- function(model, term_index) {
  
  beta <- coef(model)
  V <- vcov(model)
  
  term_index <- term_index[!is.na(term_index)]
  
  if (length(term_index) == 0) {
    return(NA_real_)
  }
  
  b <- beta[term_index]
  VV <- V[term_index, term_index, drop = FALSE]
  
  stat <- as.numeric(t(b) %*% solve(VV) %*% b)
  df <- length(b)
  
  p <- pchisq(stat, df = df, lower.tail = FALSE)
  
  return(p)
}

get_rcs_pvalues_wald <- function(model, exposure, model_name, timing_label) {
  
  coef_names <- names(coef(model))
  
  rcs_index <- grep(
    exposure,
    coef_names,
    fixed = TRUE
  )
  
  if (length(rcs_index) == 0) {
    stop(paste0("No RCS coefficients found for: ", exposure))
  }
  
  linear_index <- rcs_index[1]
  nonlinear_index <- rcs_index[-1]
  
  overall_p <- wald_test_terms(
    model = model,
    term_index = rcs_index
  )
  
  nonlinear_p <- wald_test_terms(
    model = model,
    term_index = nonlinear_index
  )
  
  data.frame(
    model = model_name,
    timing = timing_label,
    exposure = exposure,
    n_rcs_terms = length(rcs_index),
    overall_p = overall_p,
    nonlinear_p = nonlinear_p,
    coef_names = paste(coef_names[rcs_index], collapse = " | ")
  )
}

