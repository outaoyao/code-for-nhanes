map_or_to_score <- function(hours_val, rcs_plot_data) {
  
  if (is.na(hours_val)) return(NA_integer_)
  
  idx <- which.min(abs(rcs_plot_data$hours - hours_val))
  predicted_or <- rcs_plot_data$yhat[idx]
  nadir_or <- min(rcs_plot_data$yhat, na.rm = TRUE)
  
  dplyr::case_when(
    predicted_or <= VAL_REF * nadir_or ~ 0L,
    predicted_or <= VAL_MILD * nadir_or ~ 1L,
    predicted_or <= VAL_MODERATE * nadir_or ~ 2L,
    TRUE ~ 3L
  )
}

summarize_rcs_intervals <- function(rcs_data, label) {
  
  rcs_data$score <- sapply(
    rcs_data$hours,
    map_or_to_score,
    rcs_plot_data = rcs_data
  )
  
  gradient_labels <- c(
    "0" = "Reference",
    "1" = "Mild",
    "2" = "Moderate",
    "3" = "High"
  )
  
  tab <- rcs_data %>%
    group_by(score) %>%
    summarise(
      Start_Hour = min(hours),
      End_Hour = max(hours),
      .groups = "drop"
    ) %>%
    mutate(
      Gradient = gradient_labels[as.character(score)],
      Timing = label
    )
  
  tab
}

