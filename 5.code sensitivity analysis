  data=dat_rcs
)

# ==============================================================================
# 13. FULLY ADJUSTED MODEL 4
# ==============================================================================

formula_rcs <- as.formula(
  paste(outcome,"~",paste(c(rcs_vars,cov_model4),collapse="+"))
)

fit_rcs <- svyglm(
  formula_rcs,
  design=design,
  family=quasibinomial()
)

cat("Survey-weighted RCS Model 4 fitted successfully.\n")

# ==============================================================================
# 14. OVERALL AND NONLINEAR WALD TESTS
# ==============================================================================

beta <- coef(fit_rcs)
V <- vcov(fit_rcs)

rcs_terms <- grep("^RCS",names(beta),value=TRUE)
if(length(rcs_terms)<2) stop("Insufficient RCS coefficients.")

beta_rcs <- beta[rcs_terms]
V_rcs <- V[rcs_terms,rcs_terms,drop=FALSE]

wald_test <- function(b,V){
  as.numeric(t(b)%*%solve(V)%*%b)
}

wald_overall <- wald_test(beta_rcs,V_rcs)
df_overall <- length(beta_rcs)
p_overall <- pchisq(wald_overall,df_overall,lower.tail=FALSE)

beta_nonlin <- beta_rcs[-1]
V_nonlin <- V_rcs[-1,-1,drop=FALSE]

wald_nonlin <- wald_test(beta_nonlin,V_nonlin)
df_nonlin <- length(beta_nonlin)
p_nonlin <- pchisq(wald_nonlin,df_nonlin,lower.tail=FALSE)

format_p <- function(p)
  ifelse(is.na(p),NA_character_,
         ifelse(p<0.001,"<0.001",sprintf("%.3f",p)))

p_table <- data.frame(
  Analysis="Complete-case RCS",
  Test=c("Overall association","Nonlinear association"),
  Wald=c(wald_overall,wald_nonlin),
  df=c(df_overall,df_nonlin),
  P_value=c(p_overall,p_nonlin),
  P_formatted=c(format_p(p_overall),format_p(p_nonlin))
)

print(p_table)

write.csv(
  p_table,
  file.path(out_dir,"Step20_CC_RCS_P_values.csv"),
  row.names=FALSE
)

# ==============================================================================
# 15. PREDICTION GRID
# ==============================================================================

x_seq <- seq(plot_limits[1],plot_limits[2],length.out=300)

Xnew <- Hmisc::rcspline.eval(
  x_seq,knots=knots,inclx=TRUE
)
Xnew <- as.matrix(Xnew)[,seq_along(rcs_terms),drop=FALSE]

Xref <- Hmisc::rcspline.eval(
  reference_value,knots=knots,inclx=TRUE
)
Xref <- as.numeric(Xref)[seq_along(rcs_terms)]

# ==============================================================================
# 16. CONTRAST-BASED OR AND 95% CI
# ==============================================================================

Xdiff <- sweep(Xnew,2,Xref,"-")
log_OR <- as.vector(Xdiff%*%beta_rcs)

contrast_var <- rowSums((Xdiff%*%V_rcs)*Xdiff)
contrast_var <- pmax(contrast_var,0)
contrast_SE <- sqrt(contrast_var)

curve <- data.frame(
  sleep_rhythm_index_z=x_seq,
  log_OR=log_OR,
  SE=contrast_SE,
  OR=exp(log_OR),
  CI_lower=exp(log_OR-1.96*contrast_SE),
  CI_upper=exp(log_OR+1.96*contrast_SE)
)

curve <- bind_rows(
  curve,
  data.frame(
    sleep_rhythm_index_z=reference_value,
    log_OR=0,SE=0,OR=1,CI_lower=1,CI_upper=1
  )
) %>%
  arrange(sleep_rhythm_index_z)

write.csv(
  curve,
  file.path(out_dir,"Step20_CC_RCS_curve_data.csv"),
  row.names=FALSE
)

# ==============================================================================
