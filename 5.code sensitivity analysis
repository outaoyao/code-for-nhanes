pool_MI <- function(df,group_vars){
  
  df %>%
    group_by(
      across(
        all_of(group_vars)
      )
    ) %>%
    summarise(
      beta_mean=mean(beta),
      within_var=mean(SE^2),
      between_var=var(beta),
      total_var=
        within_var+
        (1+1/M)*between_var,
      pooled_SE=sqrt(total_var),
      OR=exp(beta_mean),
      CI_lower=
        exp(
          beta_mean-
            1.96*pooled_SE
        ),
      CI_upper=
        exp(
          beta_mean+
            1.96*pooled_SE
        ),
      p_value=
        2*
        pnorm(
          -abs(
            beta_mean/
              pooled_SE
          )
        ),
      .groups="drop"
    )
}

