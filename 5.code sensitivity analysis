pool_MI <- function(df){
  
  
  df %>%
    
    filter(
      
      term=="sleep_rhythm_index_z"
      
    )%>%
    
    group_by(
      
      Outcome
      
    )%>%
    
    summarise(
      
      beta_mean =
        mean(beta),
      
      within_var =
        mean(SE^2),
      
      between_var =
        var(beta),
      
      total_var =
        within_var+
        (1+1/20)*between_var,
      
      pooled_SE =
        sqrt(total_var),
      
      OR =
        exp(beta_mean),
      
      CI_lower =
        exp(
          beta_mean-
            1.96*pooled_SE
        ),
      
