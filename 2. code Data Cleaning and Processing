################################################################################
# Script Name: 7. Covariate Processing - Diabetes Status
# Purpose:
#   Harmonize NHANES diabetes / borderline diabetes status across 2017-2023 cycles.
#
# Manuscript-consistent definition:
#   Diabetes or borderline diabetes was defined using self-reported physician
#   diagnosis from DIQ010.
#
# Core variable:
#   DIQ010:
#     Doctor told you have diabetes
#     1 = Yes
#     2 = No
#     3 = Borderline
#     7 = Refused
#     9 = Don't know
#
# Analytic variable:
#   diabetes_or_prediabetes:
#     0 = No
#     1 = Yes or borderline diabetes
#
# Data Cycles:
#   - 2017-March 2020: P_DIQ
#   - 2021-2023: DIQ_L
#
# Output:
#   - D:/code/7.data.rds
################################################################################

# 1. Environment & Libraries ---------------------------------------------------

library(nhanesA)
library(tidyverse)
library(stringr)

# 2. Environment ---------------------------------------------------------------

export_dir <- "D:/code"

if (!dir.exists(export_dir)) {
  dir.create(export_dir, recursive = TRUE)
}

qc_dir <- file.path(export_dir, "qc_outputs")

if (!dir.exists(qc_dir)) {
  dir.create(qc_dir, recursive = TRUE)
}

# 3. Helper Functions ----------------------------------------------------------

clean_diq010_code <- function(x) {
  
  x_chr <- as.character(x)
  x_chr <- str_trim(x_chr)
  x_low <- str_to_lower(x_chr)
  
  case_when(
    is.na(x_chr) ~ NA_real_,
    
    # Numeric codes
    x_chr == "1" ~ 1,
    x_chr == "2" ~ 2,
    x_chr == "3" ~ 3,
    
    # Character labels from nhanesA
    x_low == "yes" ~ 1,
    x_low == "no" ~ 2,
    str_detect(x_low, "borderline") ~ 3,
    
    # Invalid / missing response labels
    x_low %in% c(
      "",
      ".",
      "7",
      "9",
      "77",
      "99",
      "refused",
      "don't know",
      "dont know",
      "missing",
      "na"
    ) ~ NA_real_,
    
    TRUE ~ NA_real_
  )
}

process_diabetes_cycle <- function(table_name, cycle_label) {
  
  cat("Processing diabetes data:", cycle_label, "\n")
  
  raw_data <- nhanes(table_name)
  
  required_vars <- c("SEQN", "DIQ010")
  
  missing_vars <- setdiff(required_vars, names(raw_data))
  
  if (length(missing_vars) > 0) {
    stop(
      "Missing required diabetes variables in ",
      table_name,
      ": ",
      paste(missing_vars, collapse = ", ")
    )
  }
  
  cat("\nRaw DIQ010 distribution for", cycle_label, ":\n")
  print(table(raw_data$DIQ010, useNA = "ifany"))
  
  processed <- raw_data %>%
    as_tibble() %>%
    select(all_of(required_vars)) %>%
    mutate(
      SEQN = suppressWarnings(as.numeric(SEQN)),
      
      DIQ010_raw = DIQ010,
      
      DIQ010 = clean_diq010_code(DIQ010),
      
      diabetes_status_3level = case_when(
        DIQ010 == 2 ~ 0, # No
        DIQ010 == 3 ~ 1, # Borderline
        DIQ010 == 1 ~ 2, # Yes
        TRUE        ~ NA_real_
      ),
      
      diabetes_status_3level_label = factor(
        diabetes_status_3level,
        levels = c(0, 1, 2),
        labels = c(
          "No",
          "Borderline",
          "Yes"
        )
      ),
      
      diabetes_or_prediabetes = case_when(
        DIQ010 == 2 ~ 0,
        DIQ010 %in% c(1, 3) ~ 1,
        TRUE ~ NA_real_
      ),
      
      diabetes_or_prediabetes_label = factor(
        diabetes_or_prediabetes,
        levels = c(0, 1),
        labels = c(
          "No",
          "Yes/Borderline"
        )
      ),
      
      # Backward-compatible names used in previous scripts
      diabetes_status = diabetes_or_prediabetes,
      diabetes_label = diabetes_or_prediabetes_label,
      
      CYCLE = cycle_label
    )
  
  return(processed)
}

# 4. Process Cycles ------------------------------------------------------------

