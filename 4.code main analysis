make_newdata <- function(exposure){
  nd <- data.frame(x=seq(0,24,length.out=200)); names(nd)[1] <- exposure
  for(v in cov_model4){
    if(is.factor(dat_ref[[v]])){
      nd[[v]] <- factor(rep(as.character(ref_cov[[v]]),nrow(nd)),levels=levels(dat_ref[[v]]))
    } else nd[[v]] <- rep(ref_cov[[v]],nrow(nd))
  }
  nd
}

predict_rcs <- function(pool,exposure,timing){
  nd <- make_newdata(exposure)
  X <- model.matrix(delete.response(terms(pool$template)),data=nd)
  common <- intersect(colnames(X),names(pool$beta))
  X <- X[,common,drop=FALSE]; b <- pool$beta[common]; V <- pool$V[common,common,drop=FALSE]
  lp <- drop(X%*%b); ref <- which.min(lp); D <- sweep(X,2,X[ref,],"-")
  logOR <- drop(D%*%b); se <- sqrt(pmax(rowSums((D%*%V)*D),0))
  data.frame(hours=nd[[exposure]],yhat=exp(logOR),
             lower=exp(logOR-1.96*se),upper=exp(logOR+1.96*se),timing=timing)
}

