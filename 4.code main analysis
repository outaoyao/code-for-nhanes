pool_scalar_BR <- function(Q,U,dfcom){
  
  m <- length(Q)
  qbar <- mean(Q)
  ubar <- mean(U)
  b <- if(m>1) var(Q) else 0
  total <- ubar+(1+1/m)*b
  
  if(!is.finite(total)||total<0) stop("Invalid Rubin total variance.")
  
  se <- sqrt(total)
  
  if(total==0){
    return(c(
      estimate=qbar,SE=0,df=dfcom,
      lower=qbar,upper=qbar,p=NA_real_
    ))
  }
  
  lambda <- (1+1/m)*b/total
  
  df_old <- if(lambda>0) (m-1)/(lambda^2) else Inf
  
  df_obs <- ((dfcom+1)/(dfcom+3))*dfcom*(1-lambda)
  
  df <- if(is.finite(df_old)){
    1/(1/df_old+1/df_obs)
  } else {
    df_obs
  }
  
  crit <- qt(.975,df=df)
  
  c(
    estimate=qbar,
    SE=se,
    df=df,
    lower=qbar-crit*se,
    upper=qbar+crit*se,
    p=2*pt(-abs(qbar/se),df=df)
  )
}

