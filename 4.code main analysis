run_subgroup <- function(sub_var,min_n=50){
  
  cat("Subgroup:",sub_var,"\n")
  
  levels_sub <- levels(droplevels(MI_list[[1]][[sub_var]]))
  remove_vars <- c(sub_var,redundancy_map[[sub_var]])
  clean_covs <- setdiff(all_covs,remove_vars)
  
  map_df(levels_sub,function(lvl){
    
    idx0 <- MI_list[[1]][[sub_var]]==lvl
    idx0[is.na(idx0)] <- FALSE
    
    n_sub <- sum(idx0)
    n_events <- sum(
      MI_list[[1]][[outcome_var]][idx0]==1,
      na.rm=TRUE
    )
    
    if(n_sub<min_n)
      return(data.frame(
        Subgroup=sub_var,Level=lvl,n_unweighted=n_sub,n_events=n_events,
        beta=NA,se=NA,df=NA,OR=NA,lower95=NA,upper95=NA,p_value=NA
      ))
    
    dat0 <- MI_list[[1]][idx0,,drop=FALSE]
    valid_covs <- clean_covs[
      sapply(clean_covs,function(v) n_unique(dat0[[v]])>=2)
    ]
    
    estimates <- ses <- dfs <- rep(NA_real_,M)
    
    for(i in seq_len(M)){
      
      idx <- MI_list[[i]][[sub_var]]==lvl
      idx[is.na(idx)] <- FALSE
      dsub <- subset(design_list[[i]],idx)
      
      f <- as.formula(
        paste(
          outcome_var,"~",exposure_var,
          if(length(valid_covs)>0)
            paste("+",paste(valid_covs,collapse="+")) else ""
        )
      )
      
      fit <- tryCatch(
        svyglm(f,design=dsub,family=quasibinomial()),
        error=function(e) NULL
      )
      
      if(!is.null(fit)&&exposure_var%in%names(coef(fit))){
        estimates[i] <- coef(fit)[exposure_var]
        ses[i] <- sqrt(vcov(fit)[exposure_var,exposure_var])
        dfs[i] <- fit$df.residual
      }
    }
    
    pooled <- pool_scalar_BR(estimates,ses,dfs)
    
    data.frame(
      Subgroup=sub_var,Level=as.character(lvl),
      n_unweighted=n_sub,n_events=n_events,
      beta=pooled$beta,se=pooled$se,df=pooled$df,
      OR=pooled$OR,lower95=pooled$lower95,
      upper95=pooled$upper95,p_value=pooled$p_value
    )
  })
}

