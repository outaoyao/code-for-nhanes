pool_models <- function(fits){
  nm <- names(coef(fits[[1]]))
  
  if(!all(vapply(fits,function(f) identical(names(coef(f)),nm),logical(1))))
    stop("Coefficient structures differ across MI datasets.")
  
  Q <- do.call(rbind,lapply(fits,function(f) coef(f)[nm]))
  U <- lapply(fits,function(f) vcov(f)[nm,nm,drop=FALSE])
  
  if(any(!is.finite(Q))||any(vapply(U,function(x) any(!is.finite(x)),logical(1))))
    stop("Non-finite coefficient/covariance detected.")
  
  qbar <- colMeans(Q)
  ubar <- Reduce("+",U)/length(fits)
  B <- cov(Q)
  
  list(beta=qbar,V=ubar+(1+1/length(fits))*B,template=fits[[1]])
}

