# Barnard-Rubin finite-df scalar pooling
pool_scalar_BR <- function(beta,se,dfcom){
  ok <- is.finite(beta)&is.finite(se)&is.finite(dfcom)&dfcom>0
  beta <- beta[ok]; se <- se[ok]; dfcom <- dfcom[ok]; m <- length(beta)
  
  if(m<2) return(data.frame(
    beta=NA_real_,se=NA_real_,df=NA_real_,OR=NA_real_,
    lower95=NA_real_,upper95=NA_real_,p_value=NA_real_
  ))
  
  qbar <- mean(beta); W <- mean(se^2); B <- var(beta)
  T <- W+(1+1/m)*B
  if(!is.finite(T)||T<=0) stop("Invalid Rubin total variance.")
  
  se_pool <- sqrt(T)
  lambda <- (1+1/m)*B/T
  df_old <- if(lambda>0) (m-1)/(lambda^2) else Inf
  df_com <- min(dfcom)
  df_obs <- ((df_com+1)/(df_com+3))*df_com*(1-lambda)
  
  df <- if(is.finite(df_old)) 1/(1/df_old+1/df_obs) else df_obs
  crit <- qt(.975,df=df)
  p <- 2*pt(-abs(qbar/se_pool),df=df)
  
  data.frame(
    beta=qbar,se=se_pool,df=df,OR=exp(qbar),
    lower95=exp(qbar-crit*se_pool),
    upper95=exp(qbar+crit*se_pool),
    p_value=p
  )
}

# D1 finite-df multivariate MI Wald test
D1_test <- function(Qhat,Uhat,dfcom){
  
  k <- nrow(Qhat); m <- ncol(Qhat)
  if(k<1||m<2) return(list(F=NA_real_,df1=NA_real_,df2=NA_real_,p=NA_real_,riv=NA_real_))
  
  Qbar <- rowMeans(Qhat)
  Ubar <- apply(Uhat,c(1,2),mean)
  Bmat <- stats::cov(t(Qhat))
  
  invU <- tryCatch(solve(Ubar),error=function(e) NULL)
  if(is.null(invU)) return(list(F=NA_real_,df1=k,df2=NA_real_,p=NA_real_,riv=NA_real_))
  
  r <- (1+1/m)*sum(diag(Bmat%*%invU))/k
  Ttilde <- (1+r)*Ubar
  invT <- tryCatch(solve(Ttilde),error=function(e) NULL)
  if(is.null(invT)) return(list(F=NA_real_,df1=k,df2=NA_real_,p=NA_real_,riv=r))
  
  Fval <- as.numeric(t(Qbar)%*%invT%*%Qbar/k)
  dfcom <- min(dfcom[is.finite(dfcom)&dfcom>0])
  
  t0 <- k*(m-1)
  
  if(r<=.Machine$double.eps){
    df2 <- ((dfcom+1)/(dfcom+3))*dfcom
  }else{
    a <- r*t0/(t0-2)
    vstar <- ((dfcom+1)/(dfcom+3))*dfcom
    c0 <- 1/(t0-4)
    c1 <- vstar-2*(1+a)
    c2 <- vstar-4*(1+a)
    
    z <- 1/c2+
      c0*(a^2*c1/((1+a)^2*c2))+
      c0*(8*a^2*c1/((1+a)*c2^2)+4*a^2/((1+a)*c2))+
      c0*(4*a^2/(c2*c1)+16*a^2*c1/c2^3)+
      c0*(8*a^2/c2^2)
    
    df2 <- 4+1/z
  }
  
  list(F=Fval,df1=k,df2=df2,
       p=pf(Fval,df1=k,df2=df2,lower.tail=FALSE),riv=r)
}

