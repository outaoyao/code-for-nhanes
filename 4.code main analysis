run_svy_logistic <- function(dat,exposure,covariates){
  
  design <- svydesign(
    id=~SDMVPSU,strata=~SDMVSTRA,weights=~mec_adj,
    nest=TRUE,data=dat
  )
  
  f <- as.formula(
    paste(outcome,"~",paste(c(exposure,covariates),collapse="+"))
  )
  
  fit <- svyglm(f,design=design,family=quasibinomial())
  est <- summary(fit)$coef
  
  tibble(
    term=rownames(est),
    beta=est[,1],
    SE=est[,2],
    complete_df=fit$df.residual,
    OR=exp(beta),
    CI_lower=exp(beta-qt(.975,df=complete_df)*SE),
    CI_upper=exp(beta+qt(.975,df=complete_df)*SE),
    p_value=2*pt(-abs(beta/SE),df=complete_df)
  )
}

