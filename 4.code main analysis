# ==============================================================================
# 12. D1 MULTIVARIATE MI WALD TEST
#
# Li, Raghunathan & Rubin D1 method with Reiter finite-sample df adjustment.
# Overall: all RCS terms = 0
# Nonlinear: all RCS terms except first linear component = 0
# ==============================================================================

D1_test <- function(Qhat,Uhat,dfcom){
  
  k <- nrow(Qhat)
  m <- ncol(Qhat)
  
  Qbar <- rowMeans(Qhat)
  Ubar <- apply(Uhat,c(1,2),mean)
  Bmat <- stats::cov(t(Qhat))
  
  r <- (1+1/m)*sum(diag(Bmat%*%solve(Ubar)))/k
  Ttilde <- (1+r)*Ubar
  
  Fval <- as.numeric(
    t(Qbar)%*%solve(Ttilde,Qbar)/k
  )
  
  t0 <- k*(m-1)
  
  if(r<=.Machine$double.eps){
    df2 <- ((dfcom+1)/(dfcom+3))*dfcom
  } else {
    
    a <- r*t0/(t0-2)
    vstar <- ((dfcom+1)/(dfcom+3))*dfcom
    
    c0 <- 1/(t0-4)
    c1 <- vstar-2*(1+a)
    c2 <- vstar-4*(1+a)
    
    z <- 1/c2 +
      c0*(a^2*c1/((1+a)^2*c2)) +
      c0*(8*a^2*c1/((1+a)*c2^2)+4*a^2/((1+a)*c2)) +
      c0*(4*a^2/(c2*c1)+16*a^2*c1/c2^3) +
      c0*(8*a^2/c2^2)
    
    df2 <- 4+1/z
  }
  
  p <- pf(Fval,df1=k,df2=df2,lower.tail=FALSE)
  
  list(
    F=Fval,
    df1=k,
    df2=df2,
    p=p,
    riv=r
  )
}

