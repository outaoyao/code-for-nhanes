# ==============================================================================
# 6. RUBIN POOLING — FINITE DEGREES OF FREEDOM
# ==============================================================================

rubin_pool <- function(df,group_vars){
  
  df %>%
    group_by(across(all_of(group_vars))) %>%
    summarise(
      m=n(),
      beta_mean=mean(beta),
      within_var=mean(SE^2),
      between_var=var(beta),
      complete_df=mean(complete_df),
      .groups="drop"
    ) %>%
    mutate(
      total_var=within_var+(1+1/m)*between_var,
      pooled_SE=sqrt(total_var),
      
      # Rubin/Barnard-Rubin finite-df inference
      lambda=ifelse(
        total_var>0,
        (1+1/m)*between_var/total_var,
        0
      ),
      
      df_old=ifelse(
        lambda>0,
        (m-1)/(lambda^2),
        Inf
      ),
      
      df_obs=ifelse(
        complete_df>0,
        ((complete_df+1)/(complete_df+3))*complete_df*(1-lambda),
        Inf
      ),
      
      df=ifelse(
        is.finite(df_old)&is.finite(df_obs),
        1/(1/df_old+1/df_obs),
        ifelse(is.finite(df_old),df_old,df_obs)
      ),
      
      crit=qt(.975,df=df),
      OR=exp(beta_mean),
      CI_lower=exp(beta_mean-crit*pooled_SE),
      CI_upper=exp(beta_mean+crit*pooled_SE),
      p_value=2*pt(-abs(beta_mean/pooled_SE),df=df)
    )
}

