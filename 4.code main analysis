wald_p <- function(pool,exposure,nonlinear=FALSE){
  idx <- grep(exposure,names(pool$beta),fixed=TRUE)
  if(nonlinear) idx <- idx[-1]
  b <- pool$beta[idx]; V <- pool$V[idx,idx,drop=FALSE]
  stat <- drop(t(b)%*%solve(V,b))
  pchisq(stat,df=length(b),lower.tail=FALSE)
}

fmt_p <- function(p) ifelse(p<0.001,"<0.001",sprintf("%.3f",p))

