run_interaction <- function(sub_var){
  
  cat("Interaction:",sub_var,"\n")
  
  remove_vars <- c(sub_var,redundancy_map[[sub_var]])
  clean_covs <- setdiff(all_covs,remove_vars)
  
  beta_int <- vcov_int <- vector("list",M)
  df_int <- rep(NA_real_,M)
  
  for(i in seq_len(M)){
    
    dat <- MI_list[[i]]
    valid_covs <- clean_covs[
      sapply(clean_covs,function(v) n_unique(dat[[v]])>=2)
    ]
    
    f <- as.formula(
      paste(
        outcome_var,"~",paste0(exposure_var,"*",sub_var),
        if(length(valid_covs)>0)
          paste("+",paste(valid_covs,collapse="+")) else ""
      )
    )
    
    fit <- tryCatch(
      svyglm(f,design=design_list[[i]],family=quasibinomial()),
      error=function(e) NULL
    )
    
    if(is.null(fit))
      return(data.frame(
        Subgroup=sub_var,P_Interaction=NA_real_,
        Interaction_F=NA_real_,df1=NA_real_,df2=NA_real_,RIV=NA_real_
      ))
    
    beta_int[[i]] <- coef(fit)
    vcov_int[[i]] <- vcov(fit)
    df_int[i] <- fit$df.residual
  }
  
  # Require identical coefficient structure before D1 pooling
  if(!all(vapply(
    beta_int,function(x) identical(names(x),names(beta_int[[1]])),logical(1)
  ))) stop("Interaction coefficient structure differs across MI: ",sub_var)
  
  int_terms <- grep(
    paste0("^",exposure_var,":|:",exposure_var,"$"),
    names(beta_int[[1]]),value=TRUE
  )
  
  if(length(int_terms)==0)
    return(data.frame(
      Subgroup=sub_var,P_Interaction=NA_real_,
      Interaction_F=NA_real_,df1=NA_real_,df2=NA_real_,RIV=NA_real_
    ))
  
  Qhat <- do.call(
    cbind,
    lapply(beta_int,function(b) b[int_terms])
  )
  
  Uhat <- array(
    NA_real_,
    dim=c(length(int_terms),length(int_terms),M)
  )
  
  for(i in seq_len(M))
    Uhat[,,i] <- vcov_int[[i]][int_terms,int_terms,drop=FALSE]
  
  tst <- D1_test(Qhat,Uhat,df_int)
  
  data.frame(
    Subgroup=sub_var,
    P_Interaction=tst$p,
    Interaction_F=tst$F,
    df1=tst$df1,
    df2=tst$df2,
    RIV=tst$riv
  )
}

