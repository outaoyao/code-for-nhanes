  ),
  Nonlinear_P=c(
    wald_p(pool_wd,"sleep_midpoint_weekday_hours",TRUE),
    wald_p(pool_we,"sleep_midpoint_weekend_hours",TRUE)
  )
) %>%
  mutate(
