prep_behavior <- function(dat,type){
  
  dat <- select_full(dat)
  
  lc <- pick_col(
    dat,
    c("Behavior","Exposure","behavior","exposure")
  )
  
  if(is.null(lc)){
    stop("Behavior/exposure column not found.")
  }
  
  raw_label <- as.character(dat[[lc]])
  
  keep <- !grepl(
    "sensitivity",
    raw_label,
    ignore.case=TRUE
  )
  
  dat <- dat[keep,,drop=FALSE]
  raw_label <- raw_label[keep]
  
  eff <- extract_effect(dat,type)
  
  label <- case_when(
    grepl("shade",raw_label,ignore.case=TRUE) ~
      "Frequent shade seeking",
    
    grepl("long.*sleeve|sleeve",raw_label,ignore.case=TRUE) ~
      "Frequent long-sleeved clothing use",
    
    grepl("sunscreen",raw_label,ignore.case=TRUE) ~
      "Frequent sunscreen use",
    
    TRUE ~ raw_label
  )
  
  tibble(
    label=label,
    estimate=eff$estimate,
    lower=eff$lower,
    upper=eff$upper
  ) %>%
    distinct(label,.keep_all=TRUE) %>%
    filter(
      label %in% c(
        "Frequent shade seeking",
        "Frequent long-sleeved clothing use",
        "Frequent sunscreen use"
      )
    ) %>%
    mutate(
      label=factor(
        label,
        levels=rev(c(
          "Frequent shade seeking",
          "Frequent long-sleeved clothing use",
          "Frequent sunscreen use"
        ))
      )
    )
}

# ==============================================================================
# 5. PREPARE OUTDOOR-TIME RESULTS
# ==============================================================================

prep_outdoor <- function(dat,type){
  
  dat <- select_full(dat)
  
  lc <- pick_col(
    dat,
    c("Exposure","Behavior","exposure","behavior")
  )
  
  if(is.null(lc)){
    stop("Outdoor exposure column not found.")
  }
  
  raw_label <- as.character(dat[[lc]])
  
  eff <- extract_effect(dat,type)
  
  label <- case_when(
    
    grepl("non-work|nonwork",raw_label,ignore.case=TRUE) ~
      "Non-work/non-school-day outdoor time",
    
    grepl("work/school|workday",raw_label,ignore.case=TRUE) ~
      "Work/school-day outdoor time",
    
    grepl("mean",raw_label,ignore.case=TRUE) ~
      "Mean daytime outdoor time*",
    
    TRUE ~ raw_label
  )
  
  tibble(
    label=label,
    estimate=eff$estimate,
    lower=eff$lower,
    upper=eff$upper
  ) %>%
    distinct(label,.keep_all=TRUE) %>%
    filter(
      label %in% c(
        "Work/school-day outdoor time",
        "Non-work/non-school-day outdoor time",
        "Mean daytime outdoor time*"
      )
    ) %>%
    mutate(
      label=factor(
        label,
        levels=rev(c(
          "Work/school-day outdoor time",
          "Non-work/non-school-day outdoor time",
          "Mean daytime outdoor time*"
        ))
      )
    )
}

