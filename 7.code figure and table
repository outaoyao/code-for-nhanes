  ) %>%
  transmute(
    Sensitivity_analysis="Alternative P10–P90 score",
    Definition="Continuous score",
    Comparison="Per 1-point higher score",
    OR_95CI=clean_ci(OR_95CI),
    P_value=vapply(P,fmt_p,character(1))
  )

p10_cat <- p10 %>%
  filter(Analysis=="P10-P90 score categories") %>%
  transmute(
    Sensitivity_analysis="Alternative P10–P90 score",
    Definition=case_when(
      grepl("1-2",Category,fixed=TRUE) ~ "Score category: 1–2",
      grepl(">=3",Category,fixed=TRUE) ~ "Score category: ≥3",
      TRUE ~ Category
    ),
    Comparison="vs 0",
    OR_95CI=clean_ci(OR_95CI),
    P_value=vapply(P,fmt_p,character(1))
  )

p10_ref <- data.frame(
  Sensitivity_analysis="Alternative P10–P90 score",
  Definition="Score category: 0",
  Comparison="Reference",
  OR_95CI="1.00 (reference)",
  P_value="—",
  stringsAsFactors=FALSE
)

