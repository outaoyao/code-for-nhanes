col_text<-"#1F1F1F"

# ==============================================================================
# 3. SLEEP REFERENCE VALUES
# ==============================================================================

sleep_data<-tibble(
  variable=c(
    "Weekday sleep onset","Weekend sleep onset",
    "Weekday midpoint of sleep","Weekend midpoint of sleep",
    "Weekday wake time","Weekend wake time"
  ),
  hour=c(23.0,23.0,2.5,3.5,6.5,7.5),
  domain=c(
    "Sleep onset","Sleep onset",
    "Sleep midpoint","Sleep midpoint",
    "Wake time","Wake time"
  ),
  day_type=c("Weekday","Weekend","Weekday","Weekend","Weekday","Weekend")
)

# ==============================================================================
# 4. CLOCK FUNCTIONS
# ==============================================================================

clock_xy<-function(hour,radius=1){
  theta<-2*pi*(hour%%24)/24
  tibble(x=radius*sin(theta),y=radius*cos(theta))
}

format_clock<-function(h){
  hh<-floor(h)%%24
  mm<-round((h-floor(h))*60)
  if(mm==60){
    hh<-(hh+1)%%24
    mm<-0
  }
  sprintf("%02d:%02d",hh,mm)
}

# ==============================================================================
# 5. EXACT MARKER POSITIONS
# ==============================================================================

marker_xy<-clock_xy(sleep_data$hour,radius=1)

sleep_data<-bind_cols(sleep_data,marker_xy)%>%
  mutate(time_label=vapply(hour,format_clock,character(1)))

cat("\nExact sleep timing positions:\n")

print(
  sleep_data%>%
    select(variable,hour,time_label,x,y)
)

# ==============================================================================
# 6. CLOCK TICKS
# ==============================================================================

# Minor ticks: every 30 minutes
minor_hours<-seq(0,23.5,by=0.5)
minor_inner<-clock_xy(minor_hours,radius=0.955)
minor_outer<-clock_xy(minor_hours,radius=1)

minor_ticks<-tibble(
  x=minor_inner$x,
  y=minor_inner$y,
  xend=minor_outer$x,
  yend=minor_outer$y
)

# Major ticks: every hour
major_hours<-seq(0,23,by=1)
major_inner<-clock_xy(major_hours,radius=0.92)
major_outer<-clock_xy(major_hours,radius=1)

major_ticks<-tibble(
  x=major_inner$x,
  y=major_inner$y,
  xend=major_outer$x,
  yend=major_outer$y
)

# Clock labels: every 3 hours
label_hours<-seq(0,21,by=3)
clock_label_xy<-clock_xy(label_hours,radius=1.15)

clock_labels<-tibble(
  label=sprintf("%02d:00",label_hours),
  x=clock_label_xy$x,
  y=clock_label_xy$y
)

# ==============================================================================
# 7. DAY / NIGHT BACKGROUND
# ==============================================================================

circle_path<-function(start_hour,end_hour,radius=1,n=400){
  if(end_hour<=start_hour) end_hour<-end_hour+24
  hrs<-seq(start_hour,end_hour,length.out=n)
  clock_xy(hrs,radius)
}

# Day: 06:00–18:00
day_poly<-bind_rows(
  tibble(x=0,y=0),
  circle_path(6,18),
  tibble(x=0,y=0)
)

# Night: 18:00–06:00
night_poly<-bind_rows(
  tibble(x=0,y=0),
  circle_path(18,30),
  tibble(x=0,y=0)
)

# ==============================================================================
# 8. LABEL POSITIONS
# ==============================================================================

label_pos<-tibble(
  variable=c(
    "Weekday midpoint of sleep",
    "Weekend midpoint of sleep",
    "Weekday wake time",
    "Weekend wake time",
    "Weekday sleep onset",
    "Weekend sleep onset"
  ),
  label_x=c(1.55,1.55,1.55,1.55,-1.55,-1.55),
  label_y=c(
    1.10,   # Weekday midpoint 02:30
    0.67,   # Weekend midpoint 03:30
    0.00,   # Weekday wake 06:30
    -0.60,   # Weekend wake 07:30
    0.90,   # Weekday onset 23:00
    0.45    # Weekend onset 23:00
