theme_pub <- function(base_size=10){
  theme_classic(base_size=base_size,base_family="sans")+
    theme(
      axis.line.y=element_blank(),
      axis.ticks.y=element_blank(),
      axis.line.x=element_line(colour="black",linewidth=0.45),
      axis.ticks.x=element_line(colour="black",linewidth=0.35),
      axis.text=element_text(colour="black"),
      axis.text.x=element_text(size=base_size*0.90),
      axis.text.y=element_text(size=base_size*0.92),
      axis.title.x=element_text(size=base_size,margin=margin(t=5)),
      axis.title.y=element_blank(),
      plot.title=element_text(
        face="bold",
        size=base_size*1.25,
        hjust=0,
        margin=margin(b=2)
      ),
      plot.margin=margin(5,8,4,5)
    )
}

# ==============================================================================
# 9. MINIMALIST COEFFICIENT PLOT
#    a–d fixed to upper-left corner of EACH COMPLETE PANEL
# ==============================================================================

make_section <- function(dat,panel_letter,type=c("OR","Beta"),
                         colour,xlab,show_values=FALSE){
  
  type <- match.arg(type)
  ref <- if(type=="OR") 1 else 0
  
  xmin <- min(c(dat$lower,ref),na.rm=TRUE)
  xmax <- max(c(dat$upper,ref),na.rm=TRUE)
  span <- xmax-xmin
  
  if(!is.finite(span) || span<=0)
    span <- if(type=="OR") 0.25 else 0.10
  
  xmin <- xmin-0.50*span
  xmax <- xmax+0.50*span
  if(type=="OR") xmin <- max(0.01,xmin)
  
  d <- dat %>%
    mutate(
      value_text=if(type=="OR")
        sprintf("%.2f (%.2f–%.2f)",estimate,lower,upper)
      else
        sprintf("%.3f (%.3f–%.3f)",estimate,lower,upper)
    )
  
  # --------------------------------------------------------------------------
  # Forest component
  # --------------------------------------------------------------------------
  
  p <- ggplot(d,aes(x=estimate,y=label))+
    
    geom_vline(
      xintercept=ref,
      linetype="dashed",
      linewidth=0.45,
      colour="grey55"
    )+
    
    geom_segment(
      aes(x=lower,xend=upper,y=label,yend=label),
      linewidth=0.85,
      colour=colour,
      lineend="round"
    )+
    
    geom_point(
      shape=16,
      size=3.1,
      colour=colour
    )+
    
    scale_x_continuous(
      limits=c(xmin,xmax),
      breaks=pretty(c(xmin,xmax),n=5),
      expand=expansion(mult=c(0,0))
    )+
    
    labs(
      x=xlab,
      y=NULL
    )+
    
    coord_cartesian(clip="off")+
    
    theme_pub()
  
  # ==========================================================================
  # CLEAN VERSION
  # Add panel letter AFTER plot construction
  # ==========================================================================
  
  if(!show_values){
    
    panel_core <- ggdraw(p)
    
    panel_final <- panel_core +
      draw_label(
        panel_letter,
        x=0.006,
        y=0.985,
        hjust=0,
        vjust=1,
        fontface="bold",
        fontfamily="sans",
        size=15
      )
    
    return(panel_final)
  }
  
  # ==========================================================================
  # VALUES COLUMN
  # ==========================================================================
  
  value_plot <- ggplot(d,aes(x=1,y=label))+
    
    geom_text(
      aes(label=value_text),
      hjust=0,
      size=3.05,
      family="sans",
      colour="black"
    )+
    
    annotate(
      "text",
      x=1,
      y=Inf,
      label=if(type=="OR")
        "OR (95% CI)"
      else
        "\u03b2 (95% CI)",
      hjust=0,
      vjust=1.35,
      fontface="bold",
      family="sans",
      size=3.0
    )+
    
    scale_x_continuous(
      limits=c(1,2.35),
      expand=c(0,0)
    )+
    
    scale_y_discrete(
      limits=levels(d$label)
    )+
    
    coord_cartesian(clip="off")+
    
    theme_void(base_family="sans")+
    
    theme(
      plot.margin=margin(27,2,19,8)
    )
  
  # --------------------------------------------------------------------------
  # Combine forest + numerical column FIRST
  # --------------------------------------------------------------------------
  
  panel_core <- plot_grid(
    p,
    value_plot,
    nrow=1,
    rel_widths=c(0.75,0.25),
    align="h",
    axis="tb"
  )
  
  # --------------------------------------------------------------------------
  # THEN add a/b/c/d relative to the WHOLE panel
  # --------------------------------------------------------------------------
  
  panel_final <- ggdraw(panel_core) +
    draw_label(
      panel_letter,
      x=0.006,
      y=0.985,
      hjust=0,
      vjust=1,
      fontface="bold",
      fontfamily="sans",
      size=15
    )
  
  panel_final
}
