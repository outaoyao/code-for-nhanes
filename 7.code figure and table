pick_col <- function(dat,x){
  z <- x[x %in% names(dat)]
  if(length(z)==0) NULL else z[1]
}

select_full <- function(dat){
  
  mc <- pick_col(dat,c("Model","model","Model_label"))
  
  if(is.null(mc)){
    stop("Model column not found.")
  }
  
  x <- as.character(dat[[mc]])
  
  keep <- grepl(
    "^Model ?2$|Model2_full|Model2$|fully adjusted",
    x,
    ignore.case=TRUE
  )
  
  if(!any(keep)){
    stop(
      "Fully adjusted model not identified. Models: ",
      paste(unique(x),collapse=", ")
    )
  }
  
  dat[keep,,drop=FALSE]
}

parse_ci <- function(x){
  
  x <- gsub("−","-",x)
  x <- gsub("–","-",x)
  
  map_dfr(
    str_extract_all(x,"-?[0-9]+\\.?[0-9]*"),
    function(z){
      z <- as.numeric(z)
      
      tibble(
        estimate=if(length(z)>=1) z[1] else NA_real_,
        lower=if(length(z)>=2) z[2] else NA_real_,
        upper=if(length(z)>=3) z[3] else NA_real_
      )
    }
  )
}

extract_effect <- function(dat,type=c("OR","Beta")){
  
  type <- match.arg(type)
  
  ec <- pick_col(
    dat,
    if(type=="OR") c("OR","or")
    else c("Beta","beta")
  )
  
  lc <- pick_col(
    dat,
    c(
      "Lower_95CI",
      "Lower95",
      "CI_lower",
      "lower95",
      "Lower_beta"
    )
  )
  
  uc <- pick_col(
    dat,
    c(
      "Upper_95CI",
      "Upper95",
      "CI_upper",
      "upper95",
      "Upper_beta"
    )
  )
  
  if(!is.null(ec) && !is.null(lc) && !is.null(uc)){
    
    return(
      tibble(
        estimate=as.numeric(dat[[ec]]),
        lower=as.numeric(dat[[lc]]),
        upper=as.numeric(dat[[uc]])
      )
    )
  }
  
  tc <- pick_col(
    dat,
    if(type=="OR"){
      c("OR (95% CI)","OR_95CI","OR_CI")
    }else{
      c("Beta (95% CI)","Beta_95CI","Beta_CI")
    }
  )
  
  if(is.null(tc)){
    stop("Effect estimate / CI columns not identified.")
  }
  
  parse_ci(dat[[tc]])
}

