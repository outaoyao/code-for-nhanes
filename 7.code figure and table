# 2. FIND FINAL FIGURE FILES
#
# Prefer TIFF -> PNG
# PDF is not used as the plotting input to avoid rendering/device differences.
# Final combined figure is nevertheless exported as PDF.
# ==============================================================================

find_fig <- function(dir,stem){
  
  if(!dir.exists(dir))
    stop("Directory not found:\n",dir)
  
  priority <- c(
    paste0(stem,".tiff"),
    paste0(stem,".tif"),
    paste0(stem,".png")
  )
  
  candidates <- file.path(dir,priority)
  hit <- candidates[file.exists(candidates)]
  
  if(length(hit)==0){
    
    fs <- list.files(
      dir,
      pattern=paste0("^",stem,"\\.(tiff|tif|png)$"),
      full.names=TRUE,
      ignore.case=TRUE
    )
    
    if(length(fs)==0)
      stop(
        "Cannot find figure:\n",
        file.path(dir,stem),
        "\nExpected TIFF/TIF/PNG."
      )
    
    hit <- fs
  }
  
  hit[1]
}

