  filter(Model=="Model4_full") %>%
  transmute(
    Sensitivity_analysis="Complete-case analysis",
    Definition="Complete-case sample",
    Comparison="Per 1-SD higher sleep rhythm disruption index",
    OR_95CI=clean_ci(OR_95CI),
    P_value=vapply(P,fmt_p,character(1))
  )

