  phq_tab,
  cc_tab,
  p10_cont,
  p10_ref,
  p10_cat
) %>%
  mutate(
    order_group=match(
      Sensitivity_analysis,
      c(
        "Alternative depressive symptom definitions",
        "Complete-case analysis",
        "Alternative P10–P90 score"
      )
    ),
    order_row=match(
      Definition,
      c(
        "PHQ-9 ≥15",
        "Modified PHQ-9 excluding the sleep-related item",
        "Complete-case sample",
        "Continuous score",
        "Score category: 0",
        "Score category: 1–2",
        "Score category: ≥3"
      )
    )
  ) %>%
  arrange(order_group,order_row) %>%
  select(
    `Sensitivity analysis`=Sensitivity_analysis,
    `Definition / sample`=Definition,
    Comparison,
    `OR (95% CI)`=OR_95CI,
    `P value`=P_value
  )

