# 2. LOAD + QC
# ==============================================================================

phq <- read.csv(file_phq,stringsAsFactors=FALSE,check.names=FALSE)
cc  <- read.csv(file_cc,stringsAsFactors=FALSE,check.names=FALSE)
p10 <- read.csv(file_p10,stringsAsFactors=FALSE,check.names=FALSE)

check_cols <- function(x,need,label){
  miss <- setdiff(need,names(x))
  if(length(miss)>0) stop(label," missing columns: ",paste(miss,collapse=", "))
}

check_cols(phq,c("Outcome","OR","CI_lower","CI_upper","p_value"),"PHQ file")
check_cols(cc,c("Model","OR_95CI","P"),"Complete-case file")
check_cols(p10,c("Analysis","Category","OR_95CI","P"),"P10-P90 file")

fmt_p <- function(x){
  if(is.na(x)||x=="") return("—")
  if(is.character(x)&&grepl("^<",x)) return(x)
  z <- suppressWarnings(as.numeric(x))
  if(is.na(z)) return(as.character(x))
  if(z<0.001) "<0.001" else sprintf("%.3f",z)
}

fmt_ci <- function(or,lo,hi)
  sprintf("%.2f (%.2f–%.2f)",or,lo,hi)

clean_ci <- function(x){
  x <- trimws(as.character(x))
  x <- gsub("\\s*-\\s*","–",x)
  x
}

# ==============================================================================
# 3. ALTERNATIVE DEPRESSIVE-SYMPTOM DEFINITIONS
# ==============================================================================

phq_tab <- phq %>%
  mutate(
    Sensitivity_analysis="Alternative depressive symptom definitions",
    Definition=case_when(
      grepl("15",Outcome,fixed=TRUE) ~ "PHQ-9 ≥15",
      grepl("Modified",Outcome,ignore.case=TRUE) |
        grepl("sleep",Outcome,ignore.case=TRUE) ~
        "Modified PHQ-9 excluding the sleep-related item",
      TRUE ~ Outcome
    ),
    Comparison="Per 1-SD higher sleep rhythm disruption index",
    OR_95CI=mapply(fmt_ci,OR,CI_lower,CI_upper),
    P_value=vapply(p_value,fmt_p,character(1))
  ) %>%
  select(Sensitivity_analysis,Definition,Comparison,OR_95CI,P_value)

if(nrow(phq_tab)!=2) stop("Expected exactly 2 PHQ sensitivity rows.")

# ==============================================================================
# 4. COMPLETE-CASE ANALYSIS — MODEL 4 ONLY
# ==============================================================================

