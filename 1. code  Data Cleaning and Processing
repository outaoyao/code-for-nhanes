#       or some days
#
# Core variables:
#   SMQ020:
#     Smoked at least 100 cigarettes in life
#     1 = Yes
#     2 = No
#     7 = Refused
#     9 = Don't know
#
#   SMQ040:
#     Do you now smoke cigarettes?
#     1 = Every day
#     2 = Some days
#     3 = Not at all
#     7 = Refused
#     9 = Don't know
#
# Data Cycles:
#   - 2017-March 2020: P_SMQ
#   - 2021-2023: SMQ_L
#
# Output:
#   - D:/code/4.data.rds
################################################################################

# 1. Libraries -----------------------------------------------------------------

library(nhanesA)
library(tidyverse)

# 2. Environment ---------------------------------------------------------------

