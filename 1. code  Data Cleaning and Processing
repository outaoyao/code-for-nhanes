# 3. Helper Functions ----------------------------------------------------------

clean_smq_code <- function(x, valid_values) {
  x <- suppressWarnings(as.numeric(x))
  
  case_when(
    is.na(x) ~ NA_real_,
    x %in% valid_values ~ x,
    TRUE ~ NA_real_
  )
}

process_smoking_cycle <- function(table_name, cycle_label) {
  
  cat("Processing smoking data:", cycle_label, "\n")
  
  raw_data <- nhanes(table_name)
  
  required_vars <- c("SEQN", "SMQ020", "SMQ040")
  
  missing_vars <- setdiff(required_vars, names(raw_data))
  
  if (length(missing_vars) > 0) {
    stop(
      "Missing required smoking variables in ",
      table_name,
      ": ",
      paste(missing_vars, collapse = ", ")
    )
  }
  
  processed <- raw_data %>%
    as_tibble() %>%
    select(all_of(required_vars)) %>%
    mutate(
      SEQN = suppressWarnings(as.numeric(SEQN)),
      
      SMQ020_raw = SMQ020,
      SMQ040_raw = SMQ040,
      
      SMQ020 = clean_smq_code(SMQ020, valid_values = c(1, 2)),
      SMQ040 = clean_smq_code(SMQ040, valid_values = c(1, 2, 3)),
      
      smoked_100_cigarettes = case_when(
        SMQ020 == 1 ~ 1,
        SMQ020 == 2 ~ 0,
        TRUE        ~ NA_real_
      ),
      
      # This variable is meaningful only among participants who smoked
      # at least 100 cigarettes in life.
      current_smoking_now_among_ever_smokers = case_when(
        SMQ020 == 1 & SMQ040 %in% c(1, 2) ~ 1,
        SMQ020 == 1 & SMQ040 == 3         ~ 0,
        SMQ020 == 1 & is.na(SMQ040)       ~ NA_real_,
        TRUE                              ~ NA_real_
      ),
      
      smoke_status = case_when(
        # Never smoker
        SMQ020 == 2 ~ 0,
        
        # Former smoker
        SMQ020 == 1 & SMQ040 == 3 ~ 1,
        
        # Current smoker
        SMQ020 == 1 & SMQ040 %in% c(1, 2) ~ 2,
        
        TRUE ~ NA_real_
      ),
      
      smoke_status_label = factor(
        smoke_status,
        levels = c(0, 1, 2),
        labels = c(
          "Never",
          "Former",
          "Current"
        )
      ),
      
      # Backward-compatible names used in older scripts
      smoke_label = smoke_status_label,
      smoke_status_num = smoke_status,
      
      CYCLE = cycle_label
    )
  
  return(processed)
}

