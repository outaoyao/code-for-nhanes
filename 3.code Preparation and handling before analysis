      levels = c("7-9 hours", "<7 hours", "≥9 hours")
    ),
    
    sex = factor(sex),
    
    race_ethnicity = factor(race_ethnicity),
    
    education = factor(education),
    
    marital_status = factor(marital_status),
    
    smoke_status = factor(
      smoke_status,
      levels = c(0, 1, 2),
      labels = c("Never", "Former", "Current")
    ),
    
    Alcohol_Status = factor(
      Alcohol_Status,
      levels = c(0, 1, 2),
      labels = c("Never", "Non-heavy ever drinker", "Heavy")
    ),
    
    diabetes_or_prediabetes = factor(
      diabetes_or_prediabetes,
      levels = c(0, 1),
      labels = c("No", "Diabetes/prediabetes")
    ),
    
    htn_status = factor(
      htn_status,
      levels = c(0, 1),
      labels = c("No", "Yes")
    ),
    
    work_status = factor(
      work_status,
      levels = c(0, 1),
      labels = c("Employed/with job", "Not currently working")
    )
  )

# 6. Missingness before imputation --------------------------------------------

missing_before <- tibble(
  Variable = names(df_mi),
  Missing_n = map_int(
    names(df_mi),
    ~ sum(is.na(df_mi[[.x]]))
  ),
  Total_N = nrow(df_mi),
  Missing_percent = round(
    100 * Missing_n / Total_N,
    2
  )
) %>%
  arrange(desc(Missing_percent), Variable)

cat("\n--- Missingness before imputation ---\n")
print(
  missing_before %>%
    filter(Missing_n > 0)
)

write.csv(
  missing_before,
  file.path(qc_dir, "Step14_MI_missingness_before.csv"),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

# 7. Configure mice ------------------------------------------------------------

ini <- mice(
  df_mi,
  maxit = 0,
  printFlag = FALSE
)

meth <- ini$method
pred <- ini$predictorMatrix

# Variables that should not be imputed
no_impute_vars <- unique(c(
  id_vars,
  design_vars,
  outcome_vars,
  sleep_vars
))

# Clear all methods first
meth[] <- ""

# Assign imputation methods only to variables with missingness
meth[impute_continuous] <- "pmm"
meth[impute_binary] <- "logreg"
meth[impute_multiclass] <- "polyreg"

# Ensure variables without missingness are not assigned methods
observed_missing_n <- map_int(
  names(df_mi),
  ~ sum(is.na(df_mi[[.x]]))
)

names(observed_missing_n) <- names(df_mi)

meth[observed_missing_n == 0] <- ""

# Explicitly enforce no-imputation variables
meth[no_impute_vars] <- ""

# Predictor matrix setup
# Keep fully observed predictors available,
# but do not use ID as predictor.
pred[, "SEQN"] <- 0
pred["SEQN", ] <- 0

# Rows for non-imputed variables do not matter, but setting to 0 is cleaner.
pred[id_vars,] <-0
pred[,id_vars] <-0

pred[design_vars,] <-0
pred[,design_vars] <-0

pred[outcome_vars,] <-0
pred[,outcome_vars] <-0

pred[sleep_vars,] <-0
pred[,sleep_vars] <-0

# Avoid self-prediction
diag(pred) <- 0

# 8. Method table QC -----------------------------------------------------------

method_table <- tibble(
  Variable = names(meth),
  Method = meth,
  Missing_n = missing_before$Missing_n[
    match(names(meth), missing_before$Variable)
  ],
  Missing_percent = missing_before$Missing_percent[
    match(names(meth), missing_before$Variable)
  ]
)

cat("\n--- Imputation method table ---\n")
print(
  method_table %>%
    filter(Method != "" | Missing_n > 0)
)

write.csv(
  method_table,
  file.path(qc_dir, "Step14_MI_method_table.csv"),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

