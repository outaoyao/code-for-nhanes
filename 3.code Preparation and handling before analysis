# SCRIPT: 14. Multiple Imputation for Missing Covariates - Final Version
# STUDY: NHANES 2017-2023 Sleep Timing / Depression
#
# Purpose:
#   Create multiply imputed datasets for primary association analyses.
#
# Key principles:
#   - Do NOT impute outcomes
#   - Do NOT impute core sleep exposures
#   - Do NOT impute survey design variables or weights
#   - Only impute missing covariates
#   - Fully observed covariates are retained as predictors but not imputed
#
# Input:
#   D:/code/12.Dataset_MI_Eligible.rds
#
# Outputs:
#   D:/code/14.MI_mids_object.rds
#   D:/code/14.MI_long_completed_data.rds
#   D:/code/14.MI_completed_data_list.rds
#   D:/code/14.MI_survey_design_list.rds
#
# QC outputs:
#   D:/code/qc_outputs/Step14_MI_missingness_before.csv
#   D:/code/qc_outputs/Step14_MI_missingness_after.csv
#   D:/code/qc_outputs/Step14_MI_method_table.csv
#   D:/code/qc_outputs/Step14_MI_logged_events.csv
#   D:/code/qc_outputs/Step14_MI_traceplot.pdf
#   D:/code/qc_outputs/Step14_MI_densityplot.pdf
#   D:/code/qc_outputs/Step14_MI_stripplot.pdf
################################################################################

# 1. Libraries -----------------------------------------------------------------

library(tidyverse)
library(mice)
library(survey)

options(survey.lonely.psu = "adjust")

# 2. Environment ---------------------------------------------------------------

base_path <- "D:/code"
setwd(base_path)

qc_dir <- file.path(base_path, "qc_outputs")

if (!dir.exists(qc_dir)) {
  dir.create(qc_dir, recursive = TRUE)
}

# 3. Load MI-eligible dataset --------------------------------------------------

df0 <- readRDS("12.Dataset_MI_Eligible.rds")

cat("Loaded MI-eligible dataset:\n")
cat("N =", nrow(df0), "\n")
cat("Variables =", ncol(df0), "\n\n")

# 4. Define variable sets ------------------------------------------------------

id_vars <- c(
  "SEQN"
)

design_vars <- c(
  "SDMVPSU",
  "SDMVSTRA",
  "mec_adj",
  "int_adj"
)

outcome_vars <- c(
  "PHQ9_SCORE",
  "PHQ9_depression_above_10",
  "Moderate_depression_above",
  "PHQ9_depression_above_15",
  "ModSevere_depression_above",
  "PHQ9_no_sleep_SCORE",
  "PHQ9_no_sleep_depression_above_10",
  "PHQ9_no_sleep_depression_above_9",
  "suicidal_ideation_daily"
)

sleep_vars <- c(
  "sleep_onset_wd_min",
  "wake_time_wd_min",
  "midpoint_wd_min",
  
  "sleep_onset_we_min",
  "wake_time_we_min",
  "midpoint_we_min",
  
  "sleep_onset_wd_hour",
  "wake_time_wd_hour",
  "midpoint_wd_hour",
  
  "sleep_onset_we_hour",
  "wake_time_we_hour",
  "midpoint_we_hour",
  
  "dur_wd",
  "dur_we",
  "dur_wd_cat",
  "dur_we_cat",
  "dur_wd_cat_num",
  "dur_we_cat_num"
)

# Continuous covariates requiring imputation
impute_continuous <- c(
  "INDFMPIR",
  "BMI_value",
  "MET_total",
  "sedentary_min"
)

# Binary covariates requiring imputation
# Fully observed variables such as sex are NOT listed here.
impute_binary <- c(
  "diabetes_or_prediabetes",
  "htn_status",
  "work_status"
)

# Multicategory covariates requiring imputation
# Fully observed race/ethnicity is retained as predictor but not imputed.
impute_multiclass <- c(
  "education",
  "marital_status",
  "smoke_status",
  "Alcohol_Status"
)

# Fully observed covariates retained as predictors but not imputed
complete_covariates <- c(
  "RIDAGEYR",
  "sex",
  "race_ethnicity"
)

mi_vars <- unique(c(
  id_vars,
  design_vars,
  outcome_vars,
  sleep_vars,
  complete_covariates,
  impute_continuous,
  impute_binary,
  impute_multiclass
))

missing_vars <- setdiff(mi_vars, names(df0))

if (length(missing_vars) > 0) {
  stop(
    "These required variables are missing from df0: ",
    paste(missing_vars, collapse = ", ")
  )
}

df_mi <- df0 %>%
  select(all_of(mi_vars))

# 5. Prepare variable types for mice ------------------------------------------

df_mi <- df_mi %>%
  mutate(
    SEQN = as.numeric(SEQN),
    
    SDMVPSU = factor(SDMVPSU),
    SDMVSTRA = factor(SDMVSTRA),
    
    PHQ9_depression_above_10 = factor(
