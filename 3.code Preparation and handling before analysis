smd_rows <- list()

add_smd_row <- function(
    characteristic,
    total,
    included,
    excluded,
    p_value = "",
    smd = ""
) {
  
  smd_rows[[length(smd_rows) + 1]] <<- tibble(
    Characteristic = characteristic,
    Total = total,
    Included = included,
    Excluded = excluded,
    `P value` = p_value,
    SMD = smd
  )
}

add_smd_section <- function(label) {
  
  add_smd_row(
    label,
    "",
    "",
    "",
    "",
    ""
  )
}

add_smd_cont <- function(label, var) {
  
  p <- safe_ttest(
    df_raw_smd[[var]],
    df_raw_smd$inclusion_group
  )
  
  s <- smd_cont(
    df_raw_smd[[var]],
    df_raw_smd$inclusion_group
  )
  
  add_smd_section(label)
  
  add_smd_row(
    "  Mean (SD)",
    fmt_mean_sd(df_raw_smd[[var]]),
    fmt_mean_sd(incl[[var]]),
    fmt_mean_sd(excl[[var]]),
    fmt_p(p),
    sprintf("%.3f", s)
  )
}

add_smd_cat <- function(label, var) {
  
  x_total <- factor(df_raw_smd[[var]])
  
  x_inc <- factor(
    incl[[var]],
    levels = levels(x_total)
  )
  
  x_exc <- factor(
    excl[[var]],
    levels = levels(x_total)
  )
  
  p <- safe_chisq(
    x_total,
    df_raw_smd$inclusion_group
  )
  
  s <- smd_cat(
    x_total,
    df_raw_smd$inclusion_group
  )
  
  add_smd_section(label)
  
  denom_total <- sum(!is.na(x_total))
  
  denom_inc <- sum(!is.na(x_inc))
  
  denom_exc <- sum(!is.na(x_exc))
  
  for (i in seq_along(levels(x_total))) {
    
    lv <- levels(x_total)[i]
    
    add_smd_row(
      paste0("  ", lv),
      
      fmt_n_pct_raw(
        sum(x_total == lv, na.rm = TRUE),
        denom_total
      ),
      
      fmt_n_pct_raw(
        sum(x_inc == lv, na.rm = TRUE),
        denom_inc
      ),
      
      fmt_n_pct_raw(
        sum(x_exc == lv, na.rm = TRUE),
        denom_exc
      ),
      
      ifelse(i == 1, fmt_p(p), ""),
      
      ifelse(i == 1,
             sprintf("%.3f", s),
             "")
    )
  }
}

