# 11. Derive post-imputation analysis variables --------------------------------

derive_post_mi_vars <- function(data) {
  
  data %>%
    mutate(
      smoke_status_num = case_when(
        smoke_status == "Never" ~ 0,
        smoke_status == "Former" ~ 1,
        smoke_status == "Current" ~ 2,
        TRUE ~ NA_real_
      ),
      
      Alcohol_Status_Num = case_when(
        Alcohol_Status == "Never" ~ 0,
        Alcohol_Status == "Non-heavy ever drinker" ~ 1,
        Alcohol_Status == "Heavy" ~ 2,
        TRUE ~ NA_real_
      ),
      
      diabetes_or_prediabetes_num = case_when(
        diabetes_or_prediabetes == "No" ~ 0,
        diabetes_or_prediabetes == "Diabetes/prediabetes" ~ 1,
        TRUE ~ NA_real_
      ),
      
      htn_status_num = case_when(
        htn_status == "No" ~ 0,
        htn_status == "Yes" ~ 1,
        TRUE ~ NA_real_
      ),
      
      work_status_num = case_when(
        work_status == "Employed/with job" ~ 0,
        work_status == "Not currently working" ~ 1,
        TRUE ~ NA_real_
      ),
      
      Age_cat = case_when(
        RIDAGEYR < 40 ~ "18-39 years",
        RIDAGEYR >= 40 & RIDAGEYR < 60 ~ "40-59 years",
        RIDAGEYR >= 60 ~ "≥60 years",
        TRUE ~ NA_character_
      ),
      
      Age_cat = factor(
        Age_cat,
        levels = c("18-39 years", "40-59 years", "≥60 years")
      ),
      
      Age_cat_num = as.numeric(Age_cat),
      
      PIR_cat = case_when(
        INDFMPIR < 1.30 ~ "<1.30",
        INDFMPIR >= 1.30 & INDFMPIR < 3.50 ~ "1.30-3.49",
        INDFMPIR >= 3.50 ~ "≥3.50",
        TRUE ~ NA_character_
      ),
      
      PIR_cat = factor(
        PIR_cat,
        levels = c("<1.30", "1.30-3.49", "≥3.50")
      ),
      
      PIR_cat_num = as.numeric(PIR_cat),
      
      BMI_cat = case_when(
        BMI_value < 18.5 ~ "Underweight",
        BMI_value >= 18.5 & BMI_value < 25 ~ "Normal",
        BMI_value >= 25 & BMI_value < 30 ~ "Overweight",
        BMI_value >= 30 ~ "Obese",
        TRUE ~ NA_character_
      ),
      
      BMI_cat = factor(
        BMI_cat,
        levels = c(
          "Underweight",
          "Normal",
          "Overweight",
          "Obese"
        )
      ),
      
      BMI_cat_ordinal = as.numeric(BMI_cat),
      
      MET_cat_label = case_when(
        MET_total < 600 ~ "Low",
        MET_total >= 600 & MET_total <= 3000 ~ "Moderate",
        MET_total > 3000 ~ "High",
        TRUE ~ NA_character_
      ),
      
      MET_cat_label = factor(
        MET_cat_label,
        levels = c("Low", "Moderate", "High")
      ),
      
      MET_cat_num = as.numeric(MET_cat_label),
      
      sedentary_cat_label = case_when(
        sedentary_min < 360 ~ "<6h",
        sedentary_min >= 360 & sedentary_min <= 480 ~ "6-8h",
        sedentary_min > 480 ~ ">8h",
        TRUE ~ NA_character_
      ),
      
      sedentary_cat_label = factor(
        sedentary_cat_label,
        levels = c("<6h", "6-8h", ">8h")
      ),
      
      sedentary_cat_num = as.numeric(sedentary_cat_label)
    )
}

mi_long_analysis <- mi_long %>%
  derive_post_mi_vars()

