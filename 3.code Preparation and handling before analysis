load_and_fix <- function(file_name) {
  
  file_path <- file.path(base_path, file_name)
  
  if (!file.exists(file_path)) {
    stop("Missing required file: ", file_path)
  }
  
  readRDS(file_path) %>%
    mutate(SEQN = suppressWarnings(as.numeric(as.character(SEQN))))
}

check_duplicate_seqn <- function(df, df_name) {
  
  dup_n <- df %>%
    count(SEQN, name = "n") %>%
    filter(!is.na(SEQN), n > 1) %>%
    nrow()
  
  if (dup_n > 0) {
    stop(
      "Duplicate SEQN detected in ",
      df_name,
      ". Please check before merging."
    )
  }
  
  invisible(TRUE)
}

safe_select <- function(df, vars, df_name) {
  
  missing_vars <- setdiff(vars, names(df))
  
  if (length(missing_vars) > 0) {
    stop(
      "Missing variables in ",
      df_name,
      ": ",
      paste(missing_vars, collapse = ", ")
    )
  }
  
  df %>%
    select(all_of(vars))
}

